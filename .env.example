# Google login (server-only — wrangler secret, KHÔNG commit)
# Tạo OAuth Client ID (Web) tại https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: https://gmc.egeadcompany.com
# Authorized redirect URIs: https://gmc.egeadcompany.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# GOOGLE_ALLOWED_EMAILS=you@gmail.com,other@gmail.com
# GOOGLE_ADMIN_EMAILS=you@gmail.com
# AUTH_SECRET=long-random-string
# Gmail bills (Shopify): bật Gmail API + thêm scope gmail.readonly trên cùng OAuth client
# https://console.cloud.google.com/apis/library/gmail.googleapis.com

# Namecheap API (server-only — whitelist ClientIp trong Namecheap → Profile → Tools → API Access)
# NAMECHEAP_API_USER=your_namecheap_username
# NAMECHEAP_API_KEY=your_api_key
# NAMECHEAP_USERNAME=your_namecheap_username
# NAMECHEAP_CLIENT_IP=your_public_ip_whitelisted
# NAMECHEAP_SANDBOX=false
# NAMECHEAP_PROXY_URL=http://64.225.56.106.nip.io:8880
# NAMECHEAP_PROXY_TOKEN=long-random-token

# Local dev — copy từ .env.example hoặc để trống (code dùng link mặc định trong src/lib/sheetConfig.ts)
# Trên Lovable: cập nhật cùng các biến trong Environment Variables (ghi đè mặc định)

